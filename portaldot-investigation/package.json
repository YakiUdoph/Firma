{
  "name": "firma-portaldot-interop-verifier",
  "version": "0.1.0",
  "description": "Read-only, block-pinned native/EVM interoperability verification for Portaldot V3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "firma": "./bin/firma.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "proof:build": "node experimental/onchain-proof/scripts/build-contract.mjs",
    "proof:estimate": "node experimental/onchain-proof/scripts/estimate-deployment.mjs",
    "proof:verify-code": "node experimental/onchain-proof/scripts/verify-deployed-bytecode.mjs",
    "proof:test": "node --test test/onchain-proof/artifact.test.mjs test/onchain-proof/contract.test.mjs test/onchain-proof/proof-transaction.test.mjs test/onchain-proof/report-commitment.test.mjs",
    "smoke:function": "node scripts/smoke-function.mjs",
    "verify": "node bin/firma.mjs",
    "verify:json": "node bin/firma.mjs --json",
    "test": "node --test test/*.test.mjs test/onchain-proof/*.test.mjs",
    "check": "node --check server.mjs && node --check api/verify.mjs && node --check api/check-report.mjs && node --check bin/firma.mjs && node --check public/app.js && node --check public/view-model.js && node --check src/verifier.mjs && node --check src/report-import.mjs && node --check src/independent-verifier.mjs && node --check experimental/onchain-proof/src/report-commitment.mjs && node --check experimental/onchain-proof/src/proof-transaction.mjs && npm test",
    "probe:evm": "node evm-probe.mjs",
    "probe:assets": "node evm-asset-probe.mjs",
    "probe:substrate": "node substrate-probe.mjs",
    "probe:state": "node state-probe.cjs",
    "decode:metadata": "node decode-metadata.cjs"
  },
  "dependencies": {
    "@polkadot/api": "17.0.2",
    "@polkadot/types": "17.0.2",
    "@polkadot/util": "14.0.3"
  },
  "devDependencies": {
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "axe-core": "4.11.0",
    "canonicalize": "5.1.0",
    "ethers": "6.17.0",
    "playwright-core": "1.56.1",
    "solc": "0.8.38"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
