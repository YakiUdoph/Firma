{
  "name": "firma-portaldot-interop-verifier",
  "version": "0.1.0",
  "description": "Read-only, block-pinned native/EVM interoperability verification for Portaldot V3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "firma": "./bin/firma.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "smoke:function": "node scripts/smoke-function.mjs",
    "verify": "node bin/firma.mjs",
    "verify:json": "node bin/firma.mjs --json",
    "test": "node --test",
    "check": "node --check server.mjs && node --check api/verify.mjs && node --check bin/firma.mjs && node --check public/app.js && node --check src/verifier.mjs && node --test",
    "probe:evm": "node evm-probe.mjs",
    "probe:assets": "node evm-asset-probe.mjs",
    "probe:substrate": "node substrate-probe.mjs",
    "probe:state": "node state-probe.cjs",
    "decode:metadata": "node decode-metadata.cjs"
  },
  "dependencies": {
    "@polkadot/api": "17.0.2",
    "@polkadot/types": "17.0.2",
    "@polkadot/util": "14.0.3"
  }
}
