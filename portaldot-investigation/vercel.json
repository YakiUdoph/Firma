{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/verify.mjs": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/check-report.mjs": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/onchain-proof.mjs": {
      "maxDuration": 60,
      "supportsCancellation": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' wss://test-node-v3.portaldot.dev; img-src 'self'; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; base-uri 'none'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
